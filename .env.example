# ─── TeachView — пример переменных окружения ───
# Скопируй в .env (он в .gitignore) и при необходимости поменяй значения.
# Все пути работают и на Windows, и на Linux.

# Куда на ХОСТ-машине складывать копии расшифровок (transcription_*.txt).
# Относительный путь считается от папки с docker-compose.yml.
# Можно указать и абсолютный путь, напр. D:/transcriptions или /srv/transcriptions
HOST_TRANSCRIPTION_DIR=./transcriptions
