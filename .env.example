# Copy this file to ".env" (in the same directory as docker-compose.yml)
# and fill in the values. docker compose loads .env automatically.

# ====== OpenAI ======
# Required for transcription and tag generation.
OPENAI_API_KEY=sk-REPLACE_ME
# Optional: use a custom OpenAI-compatible endpoint (proxy, Azure-style gateway, etc).
# Leave empty for the official api.openai.com.
OPENAI_BASE_URL=

# Optional model overrides
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru
TAGS_MODEL=gpt-4o-mini

# ====== Postgres ======
DB_NAME=teachview_db
DB_USER=postgres
DB_PASSWORD=password

# ====== MinIO ======
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET=teachview-videos
