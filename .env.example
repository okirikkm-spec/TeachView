# ─── TeachView — пример переменных окружения ───
# Скопируй в .env (он в .gitignore, лежит рядом с docker-compose.yml).
# docker compose загружает .env автоматически.

# Куда на ХОСТ-машине складывать копии расшифровок (transcription_*.txt).
# Относительный путь считается от папки с docker-compose.yml.
# Можно указать и абсолютный путь, напр. D:/transcriptions или /srv/transcriptions
HOST_TRANSCRIPTION_DIR=./transcriptions

# ====== Модели (опционально) ======
# Значения ниже — дефолты, заданы в Dockerfile/скриптах. Чтобы переопределить их
# через .env, переменную нужно дополнительно пробросить в docker-compose.yml
# (секция environment сервиса app).
#
# WHISPER_MODEL=large-v3          # модель faster-whisper
# WHISPER_DEVICE=cuda             # cuda | cpu
# WHISPER_COMPUTE_TYPE=float16    # float16 на cuda, int8 на cpu
# WHISPER_LANGUAGE=ru             # язык расшифровки
# TAGS_MODEL=Qwen/Qwen3-4B-Instruct-2507   # LLM для генерации тегов

# ====== Видео-кодирование (опционально) ======
# cpu — libx264 (работает везде)
# gpu — h264_nvenc (требуется NVIDIA-драйвер + nvidia-container-toolkit / Docker Desktop с GPU)
# Тоже требует проброса в environment сервиса app.
# VIDEO_ENCODER=cpu
